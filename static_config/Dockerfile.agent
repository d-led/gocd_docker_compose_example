FROM gocd/gocd-agent-alpine:v25.4.0

# The official GoCD agent image already bundles its own JRE at /gocd-jre
# (used by the wrapper scripts under /go-agent/bin) and ships git + bash.
# Installing a second JDK from apk is unnecessary and currently fails on this
# Alpine base (`java-common` trigger cannot find the apk-installed VM).
# Keep this image a plain pass-through so the official Java agent runs unmodified.
USER root

RUN apk add --no-cache bash git

USER go
